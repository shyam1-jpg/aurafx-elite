# Copy to Render Environment (or local set commands). Do not commit real secrets.

# Neon Postgres — persistent registrations (see NEON-SETUP.txt)
DATABASE_URL=

SITE_URL=https://aurafxelite.com
# AI signal demo (Render free service aura-fx-elite-ai or Vercel)
AI_DEMO_URL=https://aura-fx-elite-ai.onrender.com
PORT=3847
HOST=0.0.0.0

# Admin login (required for owner pages in production)
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_SESSION_SECRET=change_me_random_64_chars
# Optional TOTP — base32 secret from authenticator app setup
ADMIN_TOTP_SECRET=

# Optional — same secret as ADMIN_SESSION_SECRET for dashboard tokens
# Dashboard journal/history uses DATABASE_URL (Neon) when set

# PayPal — Client ID is public in browser; Secret is SERVER ONLY
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_BUSINESS_EMAIL=your-paypal@email.com
# Local testing only (never 1 in production)
ALLOW_MANUAL_PAYMENT_CONFIRM=0

# Optional AES-256 encryption for phone/address at rest (64 hex chars)
DATA_ENCRYPTION_KEY=

# Email (Resend) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=AuraFX Elite <hello@aurafxelite.com>
EMAIL_REPLY_TO=support@aurafxelite.com
EMAIL_AUTO_WELCOME=0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to openai to let the model rewrite signal wording only. Direction and levels stay with the rule engine.
AI_RATIONALE_PROVIDER=

# Optional candle upgrade. Tried before Yahoo. A failed request still falls through
# to Yahoo, then Kraken public OHLC for supported forex and PAXG gold.
# https://twelvedata.com — free tier is enough for the dashboard scan.
TWELVE_DATA_API_KEY=

# Optional economic calendar. Without it the site uses a reference schedule.
FINNHUB_API_KEY=
# Pause new signals this many minutes before and after a high-impact release. Defaults are 30 and 30.
SIGNAL_NEWS_BEFORE_MIN=30
SIGNAL_NEWS_AFTER_MIN=30

# Signal alerts. Both are optional. Users opt in on /track-record.html.
# Telegram: create a bot with BotFather and paste the token here. Never commit it.
TELEGRAM_BOT_TOKEN=
# SMTP for alert email. 587 uses STARTTLS. 465 uses TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AuraFX Elite <alerts@aurafxelite.com>

INSTITUTIONAL_MODE=demo
